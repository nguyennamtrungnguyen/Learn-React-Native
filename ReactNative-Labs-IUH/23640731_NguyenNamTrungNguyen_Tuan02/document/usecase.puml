@startuml

' =========================================================
' CẤU HÌNH BỐ CỤC
' =========================================================

left to right direction

skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam linetype ortho

skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

skinparam package {
    BackgroundColor White
    BorderColor Black
}

title USE CASE DIAGRAM - HỆ THỐNG ĐẶT PHÒNG KHÁCH SẠN


' =========================================================
' ACTOR
' =========================================================

actor "Guest\nKhách chưa đăng nhập" as Guest
actor "Customer\nKhách hàng" as Customer
actor "Partner\nĐối tác / Chủ khách sạn" as Partner
actor "Admin\nQuản trị viên" as Admin
actor "Payment Gateway\nCổng thanh toán" as Payment


' =========================================================
' HỆ THỐNG
' =========================================================

rectangle "HỆ THỐNG ĐẶT PHÒNG KHÁCH SẠN" {


' =========================================================
' 1. GUEST
' =========================================================

package "1. Guest - Khách chưa đăng nhập" {

    usecase "Xem trang chủ,\ndanh sách khách sạn và phòng" as G01

    usecase "Xem thông tin chi tiết\nkhách sạn" as G02

    usecase "Xem thông tin chi tiết\nphòng, dịch vụ và khuyến mãi" as G03

    usecase "Xem đánh giá và\nđiểm số khách sạn" as G04

    usecase "Tìm kiếm khách sạn\ntheo địa điểm, ngày, số khách" as G05

    usecase "Lọc khách sạn\ntheo giá, sao, đánh giá,\ntiện nghi, loại chỗ ở" as G06

    usecase "Sắp xếp kết quả\ntheo giá, phổ biến,\nđánh giá cao nhất" as G07

    usecase "Đăng ký tài khoản\nCustomer" as G08

    usecase "Đăng nhập hệ thống" as G09

    usecase "Khôi phục mật khẩu" as G10
}


' =========================================================
' 2. CUSTOMER
' =========================================================

package "2. Customer - Khách hàng đã đăng nhập" {

    package "2.1 Đặt phòng và thanh toán" {

        usecase "Tìm kiếm và\nlựa chọn khách sạn, phòng" as C01

        usecase "Thêm phòng vào\ngiỏ đặt phòng" as C02

        usecase "Nhập thông tin\nngười đặt và khách lưu trú" as C03

        usecase "Áp dụng mã\nkhuyến mãi" as C04

        usecase "Xác nhận thông tin\nđặt phòng" as C05

        usecase "Thanh toán trực tuyến\n(thẻ, ví điện tử,\nchuyển khoản)" as C06

        usecase "Nhận email và thông báo\nxác nhận đặt phòng" as C07
    }


    package "2.2 Quản lý tài khoản" {

        usecase "Xem và cập nhật\nthông tin cá nhân" as C08

        usecase "Đổi mật khẩu" as C09

        usecase "Quản lý phương thức\nthanh toán đã lưu" as C10

        usecase "Quản lý khách sạn/phòng\nyêu thích (Wishlist)" as C11
    }


    package "2.3 Quản lý đặt phòng" {

        usecase "Xem lịch sử\nđặt phòng" as C12

        usecase "Xem chi tiết\nđặt phòng" as C13

        usecase "Theo dõi trạng thái\nđặt phòng" as C14

        usecase "Hủy đặt phòng\ntheo chính sách" as C15

        usecase "Yêu cầu đổi ngày\nlưu trú" as C16
    }


    package "2.4 Đánh giá" {

        usecase "Đánh giá khách sạn\nsau khi sử dụng dịch vụ" as C17

        usecase "Viết nhận xét về\nphòng và dịch vụ" as C18

        usecase "Chỉnh sửa hoặc xóa\nđánh giá đã viết" as C19
    }


    package "2.5 Ưu đãi thành viên - Loyalty" {

        usecase "Tích lũy điểm thưởng\nkhi hoàn tất đặt phòng" as C20

        usecase "Xem hạng thành viên\nvà quyền lợi" as C21

        usecase "Đổi điểm thưởng\nlấy ưu đãi/giảm giá" as C22
    }
}


' =========================================================
' 3. PARTNER
' =========================================================

package "3. Partner - Đối tác / Chủ khách sạn" {

    package "3.1 Đăng ký đối tác" {

        usecase "Đăng ký tài khoản\nđối tác" as P01

        usecase "Cung cấp thông tin cá nhân\nvà thông tin khách sạn" as P02

        usecase "Gửi yêu cầu đăng ký\nkhách sạn + giấy tờ pháp lý" as P03

        usecase "Theo dõi trạng thái\nxét duyệt của Admin" as P04
    }


    package "3.2 Quản lý khách sạn" {

        usecase "Thêm thông tin\nkhách sạn" as P05

        usecase "Cập nhật thông tin\nkhách sạn" as P06

        usecase "Cập nhật địa chỉ,\nhình ảnh, mô tả, tiện nghi" as P07

        usecase "Quản lý trạng thái\nhoạt động khách sạn" as P08

        usecase "Thiết lập chính sách chung\nnhận/trả phòng, hủy,\nno-show, trẻ em, thú cưng" as P09
    }


    package "3.3 Quản lý phòng" {

        usecase "Thêm loại phòng" as P10

        usecase "Thêm phòng" as P11

        usecase "Cập nhật thông tin phòng" as P12

        usecase "Thiết lập giá phòng\ncơ bản/mùa/cuối tuần" as P13

        usecase "Thiết lập số lượng phòng\ncó thể bán" as P14

        usecase "Cập nhật hình ảnh\nvà tiện nghi phòng" as P15

        usecase "Đóng/mở bán phòng\ntheo ngày" as P16

        usecase "Đồng bộ tồn kho phòng\nthời gian thực" as P17
    }


    package "3.4 Quản lý đặt phòng" {

        usecase "Xem danh sách\nđặt phòng khách sạn" as P18

        usecase "Xem chi tiết\nđặt phòng" as P19

        usecase "Xác nhận đặt phòng" as P20

        usecase "Cập nhật trạng thái\nđặt phòng" as P21

        usecase "Xử lý hủy đặt phòng\ntheo chính sách" as P22

        usecase "Ghi nhận và xử lý\nno-show" as P23
    }


    package "3.5 Quản lý khuyến mãi" {

        usecase "Tạo chương trình\nkhuyến mãi" as P24

        usecase "Cập nhật và quản lý\nchương trình khuyến mãi" as P25

        usecase "Thiết lập giá phòng\ntheo chương trình khuyến mãi" as P26

        usecase "Thiết lập ưu đãi đặt sớm /\nphút chót / dài ngày" as P27
    }


    package "3.6 Quản lý doanh thu" {

        usecase "Xem doanh thu\ntheo khoảng thời gian" as P28

        usecase "Xem số lượng\nphòng đã bán" as P29

        usecase "Xem lịch sử thanh toán\nvà đối soát" as P30

        usecase "Theo dõi hoa hồng\nphải trả hệ thống" as P31

        usecase "Xuất báo cáo doanh thu\nExcel/PDF" as P32
    }


    package "3.7 Quản lý đánh giá" {

        usecase "Xem đánh giá\nkhách hàng" as P33

        usecase "Phản hồi đánh giá" as P34

        usecase "Báo cáo đánh giá\nvi phạm/không phù hợp" as P35
    }


    package "3.8 Quản lý nhân sự nội bộ" {

        usecase "Tạo tài khoản\nnhân viên" as P36

        usecase "Phân quyền nhân viên\ntheo vai trò" as P37

        usecase "Khóa/xóa tài khoản\nnhân viên" as P38
    }
}


' =========================================================
' 4. ADMIN
' =========================================================

package "4. Admin - Quản trị viên" {

    package "4.1 Quản lý tài khoản" {

        usecase "Quản lý tài khoản\nCustomer" as A01

        usecase "Quản lý tài khoản\nPartner" as A02

        usecase "Khóa/mở khóa\ntài khoản" as A03

        usecase "Phân quyền\nngười dùng" as A04
    }


    package "4.2 Quản lý đối tác khách sạn" {

        usecase "Xem danh sách\nPartner" as A05

        usecase "Xét duyệt đăng ký\nPartner" as A06

        usecase "Xét duyệt\nkhách sạn" as A07

        usecase "Cập nhật hoặc khóa\nhoạt động Partner" as A08

        usecase "Xem danh sách\nkhách sạn" as A09

        usecase "Xem thông tin chi tiết\nkhách sạn" as A10

        usecase "Từ chối\nkhách sạn" as A11

        usecase "Khóa/mở hoạt động\nkhách sạn" as A12

        usecase "Mở lại\nkhách sạn" as A13

        usecase "Quản lý trạng thái\nhiển thị khách sạn" as A14

        usecase "Quản lý loại phòng" as A15

        usecase "Quản lý phòng" as A16

        usecase "Cập nhật trạng thái\nphòng" as A17
    }


    package "4.3 Quản lý thanh toán và hóa đơn" {

        usecase "Quản lý giao dịch\nthanh toán" as A18

        usecase "Quản lý hóa đơn" as A19

        usecase "Quản lý hoàn tiền" as A20

        usecase "Quản lý đối soát\nvà hoa hồng" as A21
    }


    package "4.4 Quản lý khuyến mãi" {

        usecase "Tạo và quản lý chương trình\nkhuyến mãi hệ thống" as A22

        usecase "Quản lý mã giảm giá" as A23
    }


    package "4.5 Quản lý đánh giá" {

        usecase "Duyệt đánh giá" as A24

        usecase "Ẩn/hiện đánh giá" as A25

        usecase "Xử lý đánh giá\nvi phạm" as A26

        usecase "Theo dõi phản hồi\ncủa Partner" as A27
    }


    package "4.6 Thống kê và báo cáo" {

        usecase "Thống kê doanh thu" as A28

        usecase "Thống kê số lượng\nđặt phòng" as A29

        usecase "Thống kê số lượng\nkhách hàng" as A30

        usecase "Thống kê số lượng\nPartner và khách sạn" as A31

        usecase "Thống kê tình trạng\nphòng" as A32

        usecase "Báo cáo doanh thu\nvà hoa hồng" as A33
    }
}


